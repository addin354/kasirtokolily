# Ignored files for the root of the project
laravel_app/.env
laravel_app/.env.bak
laravel_app/.env.backup
laravel_app/.env.production
laravel_app/.phpunit.result.cache
laravel_app/.phpunit.cache
laravel_app/node_modules/
laravel_app/vendor/
laravel_app/public/storage
laravel_app/storage/*.key
laravel_app/storage/app/public/*
!laravel_app/storage/app/public/.gitignore
laravel_app/storage/framework/cache/data/*
!laravel_app/storage/framework/cache/data/.gitignore
laravel_app/storage/framework/views/*.php
laravel_app/storage/framework/sessions/*
!laravel_app/storage/framework/sessions/.gitignore
laravel_app/storage/logs/*.log
!laravel_app/storage/logs/.gitignore
*.log
.DS_Store
Thumbs.db
